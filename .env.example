# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Configurable Gemini model (defaults to gemini-3.7-flash)
GEMINI_MODEL="gemini-3.7-flash"

# GEMINI_FALLBACK_MODEL: Lightweight fallback model for high-throughput or low-cost classification
GEMINI_FALLBACK_MODEL="gemini-3.1-flash-lite"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Configuration
# Public keys safe for browser (respects RLS)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Server-side Supabase Service Role Key (NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Payment Providers (Optional - Server-side only)
# Mobile Money (MTN / Orange MoMo API for West & Central Africa)
MOMO_API_KEY=""
MOMO_USER_ID=""
MOMO_SUBSCRIPTION_KEY=""
MOMO_TARGET_ENVIRONMENT="sandbox"

# Stripe (Optional for Global Card Payments)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Flutterwave / Paystack (Optional for Africa-wide Payments)
FLUTTERWAVE_SECRET_KEY=""
PAYSTACK_SECRET_KEY=""

# Web Push Notification Configuration (VAPID Keys)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@ursella.app"

# Application Environment & Monitoring
NODE_ENV="development"
ENABLE_ERROR_MONITORING="true"


